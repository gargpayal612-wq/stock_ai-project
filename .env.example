# =====================================================================
# SupplyStock AI - Environment Configuration Example
# Copy to .env in each corresponding subfolder as needed
# =====================================================================

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/supplystock_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Backend Spring Boot Configuration
SERVER_PORT=8080
JWT_SECRET=9a3b8e7c1f2d5a4b6e8d0c2e4f6a8b1c3d5e7f9a1b3c5d7e9f1a3b5c7d9e1f3a
JWT_EXPIRATION_MS=86400000

# Python FastAPI Microservice
AI_SERVICE_URL=http://localhost:8000/api/v1
AI_SERVICE_PORT=8000

# Google Gemini API Key (Optional for natural language assistant)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
